[TEMPLATE]
# BridgeRouteAI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Admin API key for /v1/* and /admin/* endpoints
ADMIN_API_KEY=your-secure-admin-api-key-min-32-chars

# JWT signing secret — use: openssl rand -hex 32
JWT_SECRET=your-random-secret-at-least-32-characters-long

# Superadmin password — must be strong (min 12 chars, mixed case + numbers + symbols)
SUPERADMIN_PASSWORD=YourStr0ngP@ssword!

# PostgreSQL
POSTGRES_USER=bridgeroute
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=bridgeroute

# Redis
REDIS_PASSWORD=your-strong-redis-password

# ─── COMPOSED ────────────────────────────────────────────────────────────────
# These are auto-built from the above values in docker-compose.yml
# DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@postgres:POSTGRES_DB
# REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (no spaces after commas)
CORS_ORIGINS=http://localhost:3000

# ─── OPTIONAL ────────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@bridgeroute.local

# ─── UPSTREAM PROVIDERS ──────────────────────────────────────────────────────
# Kilo AI Gateway (primary). Free models work anonymously; a key raises limits.
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_API_KEY=
# How often the background task refreshes the Kilo model catalog (seconds)
KILO_CATALOG_REFRESH_SECONDS=300

# FreeModels (fallback)
FREE_MODELS_URL=https://freemodels-chat.freemodels.workers.dev
# How often the background task re-scrapes the FreeModels catalog (seconds)
FREE_MODELS_CATALOG_REFRESH_SECONDS=300

# Composite / Lucidity (OpenAI-compatible; free models only, id suffix `:free`)
# Get a key at https://composite.lucidity.sh/apikeys.html — required to chat,
# the model catalog is fetched without one.
COMPOSITE_API_KEY=
COMPOSITE_BASE_URL=https://composite.lucidity.sh/v1
COMPOSITE_CATALOG_REFRESH_SECONDS=300

# Septor Labs (OpenAI-compatible; free models only, id suffix `-free`)
# Get a key at https://septorlabs.com/register (signup grants $1 of credits)
# — required to chat; the free catalog is scraped from the public site.
SEPTOR_API_KEY=
SEPTOR_BASE_URL=https://api.septorlabs.com/v1
SEPTOR_SITE_URL=https://septorlabs.com
SEPTOR_CATALOG_REFRESH_SECONDS=300

# Routeway (OpenAI-compatible; free models only, id suffix `:free`)
# Get a key at https://routeway.ai/dashboard -> API Keys — required to chat;
# the model catalog (GET /v1/models) is public. Free tier: 5 req/min, 200 req/day.
ROUTEWAY_API_KEY=
ROUTEWAY_BASE_URL=https://api.routeway.ai/v1
ROUTEWAY_CATALOG_REFRESH_SECONDS=300

# Top Tools AI (OpenAI-compatible; single model "Top-Tools-Ai" with vision, 512K context)
# Get a key at https://top-tools-ai.com — required to chat; the model catalog (GET /v1/models) is public.
TOPTOOLS_API_KEY=
TOPTOOLS_BASE_URL=https://top-tools-ai.com/v1
TOPTOOLS_CATALOG_REFRESH_SECONDS=300

# DreamPrompting (OpenAI-compatible unified gateway for Groq, Mistral, NVIDIA, Cohere, Google, OpenRouter, Cloudflare, HuggingFace, Codestral, Chat)
# Get a key at https://dreamprompting.com/account — required for catalog and chat.
DREAMPROMPTING_API_KEY=
DREAMPROMPTING_BASE_URL=https://dreamprompting.com/api/v1
DREAMPROMPTING_CATALOG_REFRESH_SECONDS=300

# Clean APIs (OpenAI-compatible gateway, 33 models from Anthropic, OpenAI, Google, Meta)
# Get a key at https://cleanapis.com/register — required for catalog and chat.
CLEANAPIS_API_KEY=
CLEANAPIS_BASE_URL=https://cleanapis.com/v1
CLEANAPIS_CATALOG_REFRESH_SECONDS=300

# ModelRouter (OpenAI-compatible gateway; free text-chat models only)
# Get a key at https://modelrouter.id/dashboard. The key is required for
# catalog discovery and chat completions.
MODELROUTER_API_KEY=
MODELROUTER_BASE_URL=https://modelrouter.id/v1
MODELROUTER_CATALOG_REFRESH_SECONDS=300

# Tiarina Cloud (OpenAI-compatible gateway)
# Get a key from https://console.tiarina.cloud/ai#keys
TIARINA_API_KEY=
TIARINA_ENABLED=false
TIARINA_BASE_URL=https://ai.tiarina.cloud/v1
TIARINA_CATALOG_REFRESH_SECONDS=300

# ─── SERVER ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ZyloAI (OpenAI-compatible model gateway; catalog public, chat needs a key)
ZYLOAI_API_KEY=
ZYLOAI_BASE_URL=https://api.zyloai.net/v1
# ModelRouter kill switch (account free-tier exhausted)
MODELROUTER_ENABLED=false
BAZAARLINK_ENABLED=false
